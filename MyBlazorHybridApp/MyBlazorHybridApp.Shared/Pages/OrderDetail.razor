@page "/myorders/{orderId:int}"
@inject NavigationManager NavigationManager
@inject MyBlazorHybridApp.Shared.Services.OrderService OrderService
@using MyBlazorHybridApp.Shared.Model

<div class="top-bar">
    <a class="logo" href="">
        <img src="_content/MyBlazorHybridApp.Shared/img/logo.svg" />
    </a>
    <NavLink href="" class="nav-tab" Match="NavLinkMatch.All">
        <img src="_content/MyBlazorHybridApp.Shared/img/pizza-slice.svg" />
        <div>Get Pizza</div>
    </NavLink>
    <NavLink href="myorders" class="nav-tab">
        <img src="_content/MyBlazorHybridApp.Shared/img/bike.svg" />
        <div>My orders</div>
    </NavLink>
</div>

<div class="main">
    @if (invalidOrder)
    {
        <h2>Order not found</h2>
        <p>We're sorry but this order no longer exists.</p>
    }
    else if (orderWithStatus == null)
    {
        <div class="track-order">
            <div class="track-order-title">
                <h2>Loading...</h2>
                <p class="ml-auto mb-0">...</p>
            </div>
        </div>
    }
    else
    {
        <div class="track-order">
            <div class="track-order-title">
                <h2>
                    Order placed @orderWithStatus.Order.CreatedTime.ToLongDateString()
                </h2>
                <p class="ml-auto mb-0">
                    Status: <strong>@orderWithStatus.StatusText</strong>
                </p>
            </div>

            <div class="track-order-body">
                <div class="track-order-details">
                    @foreach (var pizza in orderWithStatus.Order.Pizzas)
                    {
                        <p>
                            <strong>
                                @(pizza.Size)" @pizza.Special.Name
                                (£@pizza.GetFormattedTotalPrice())
                            </strong>
                        </p>

                        @if (pizza.Toppings?.Any() == true)
                        {
                            <ul>
                                @foreach (var topping in pizza.Toppings)
                                {
                                    <li>@topping.Topping.Name</li>
                                }
                            </ul>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int OrderId { get; set; }

    private OrderWithStatus? orderWithStatus;
    private bool invalidOrder = false;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            orderWithStatus = await OrderService.GetOrderWithStatusAsync(OrderId);

            if (orderWithStatus == null)
                invalidOrder = true;
        }
        catch (Exception ex)
        {
            invalidOrder = true;
            Console.Error.WriteLine($"❌ Error loading order {OrderId}: {ex.Message}");
        }
    }
}
