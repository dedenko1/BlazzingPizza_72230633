@page "/calculator"

<div class="main">
<div class="container mt-1">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg rounded-3">
                <div class="card-header bg-primary text-white text-center">
                    <h3>Kalkulator Sederhana</h3>
                </div>
                <div class="card-body">
                    <div class="mb-2">
                        <label class="form-label">Masukkan angka pertama:</label>
                        <input type="number" class="form-control" @bind="angka1" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Masukkan angka kedua:</label>
                        <input type="number" class="form-control" @bind="angka2" />
                    </div>

                    <div class="mb-2">
                        <label class="form-label">Operator:</label>
                        <select class="form-select" @bind="op">
                            <option value="+">+</option>
                            <option value="-">-</option>
                            <option value="*">*</option>
                            <option value="/">/</option>
                        </select>
                    </div>

                    <div class="d-grid">
                        <button class="btn btn-success btn-lg" @onclick="Hitung">
                            Hitung
                        </button>
                    </div>

                    <hr />

                    <div class="alert alert-info text-center fs-5 mt-3">
                        <strong>Hasil:</strong> @hasil
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@code {
    private double angka1;
    private double angka2;
    private string op = "+";
    private double hasil;

    private void Hitung()
    {
        switch (op)
        {
            case "+":
                hasil = angka1 + angka2;
                break;
            case "-":
                hasil = angka1 - angka2;
                break;
            case "*":
                hasil = angka1 * angka2;
                break;
            case "/":
                hasil = angka2 != 0 ? angka1 / angka2 : double.NaN;
                break;
            default:
                hasil = 0;
                break;
        }
    }
}
